#app
NODE_ENV='development | staging | production'
BACKEND_HOST_PORT=3000
BACKEND_PORT=3000
BACKEND_LINK='http://localhost:8080'
FRONTEND_LINK='https://admin-panel.com'
LANDING_LINK='https://landing-link.com'
DATE_FORMAT='dd-MM-yyyy HH:mm:ss'

#API request limits
API_REQUEST_LIMIT=20,
#seconds
API_REFRESH_LIMIT_TIME=10

#database
MONGODB_HOST_PORT=27017
MONGODB_PORT=27017
MONGODB_HOSTNAME=hostname
MONGODB_USERNAME=admin
MONGODB_PASSWORD=password
MONGODB_URI='mongodb://admin:password@hostname:27017'
MONGODB_SUPERADMIN_EMAIL='superadmin db email'
MONGODB_SUPERADMIN_PASSWORD=password123

#redis
REDIS_HOST_PORT=6380
REDIS_PORT=6379
REDIS_HOST=localhost

#jwt
JWT_EXPIRES_IN=1d
JWT_SECRET=secretjwtkey
JWT_EXPIRES_CONFIRMATIONS=15m

#encryption
ENCRYPTION_KEY=secretEncryptionKey

#mailer
ADMIN_MAIL='usersupport@mail.com'
MAILER_SENDER='mailersender@gmail.com'
MAILER_PASSWORD='smtppassword'
MAILER_HOST='mail.adm.tools'
MAILER_PORT=587

#trello
TRELLO_API_KEY=trelloapikey

#telegram
TELEGRAM_NOTIFICATION_BOT_TOKEN='tg bot token'
TELEGRAM_ADMIN_BOT_TOKEN='tg bot token'
