#app
NODE_ENV='development | staging | production'
NODE_PORT=port
API_LINK='https://yourApiLink'

#development only
MONGODB_URI='connectionURL'

#database
MONGO_INITDB_ROOT_USERNAME='youradminusername'
MONGO_INITDB_ROOT_PASSWORD='youradminpassword'
SUPERADMIN_EMAIL='email for first admin'
SUPERADMIN_PASSWORD='password for first admin'

#jwt
JWT_EXPIRES_IN='1d'
JWT_SECRET='secretjwtkey'

#encryption
ENCRYPTION_KEY='secretEncryptionKey'

#mailer
MAILER_SENDER='mailer@mail.com'
MAILER_PASSWORD='mailerpassword'
MAILER_HOST='mailerhost'
MAILER_PORT=mailerport

#trello
TRELLO_API_KEY='trelloapplicationkey'